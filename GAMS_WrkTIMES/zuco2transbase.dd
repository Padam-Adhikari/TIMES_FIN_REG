$ONEMPTY
$ONEPS
$ONWARNING
$SET RUN_NAME 'BASELINE-REG_NEW'
$SET SCENARIO_NAME 'zuco2transbase'


SET UNITS_COM

/
'UCU'
/;

SET COM_TMAP

/
'FI'.'NRG'.'NEG_PERMIT-'
'FI'.'NRG'.'NEG_PERMIT_'
'FI1B1'.'NRG'.'NEG_PERMIT-'
'FI1B1'.'NRG'.'NEG_PERMIT_'
'FI1D9'.'NRG'.'NEG_PERMIT-'
'FI1D9'.'NRG'.'NEG_PERMIT_'
/;

SET COM_UNIT

/
'FI'.'NEG_PERMIT-'.'UCU'
'FI'.'NEG_PERMIT_'.'UCU'
'FI1B1'.'NEG_PERMIT-'.'UCU'
'FI1B1'.'NEG_PERMIT_'.'UCU'
'FI1D9'.'NEG_PERMIT-'.'UCU'
'FI1D9'.'NEG_PERMIT_'.'UCU'
/;

SET TOP_IRE

/
'IMPEXP'.'NEG_PERMIT-'.'FI'.'NEG_PERMIT-'.'IMPNRGZ'
'IMPEXP'.'NEG_PERMIT_'.'FI'.'NEG_PERMIT_'.'IMPNRGZ'
/;

SET COM_DESC

/
'FI'.'NEG_PERMIT-' 'Negative dummy var for UC: NEG_PERMIT'
'FI'.'NEG_PERMIT_' 'Positive dummy var for UC: NEG_PERMIT'
'FI1B1'.'NEG_PERMIT-' 'Negative dummy var for UC: NEG_PERMIT'
'FI1B1'.'NEG_PERMIT_' 'Positive dummy var for UC: NEG_PERMIT'
'FI1D9'.'NEG_PERMIT-' 'Negative dummy var for UC: NEG_PERMIT'
'FI1D9'.'NEG_PERMIT_' 'Positive dummy var for UC: NEG_PERMIT'
/;

SET UC_R_EACH

/
'FI'.'NEG_PERMIT'
/;

PARAMETER

UC_ACT ' '/
'NEG_PERMIT'.LHS.'FI'.2010.'EXPCO2-fromFI-biogenics'.ANNUAL 1
'NEG_PERMIT'.LHS.'FI'.2010.'EXPCO2-fromFI-DACCS'.ANNUAL 1
'NEG_PERMIT'.LHS.'FI'.2070.'EXPCO2-fromFI-biogenics'.ANNUAL 1
'NEG_PERMIT'.LHS.'FI'.2070.'EXPCO2-fromFI-DACCS'.ANNUAL 1
/;

PARAMETER

UC_IRE ' '/
'NEG_PERMIT'.LHS.'FI'.2010.'IMPNRGZ'.'NEG_PERMIT-'.ANNUAL.IMP -1
'NEG_PERMIT'.LHS.'FI'.2010.'IMPNRGZ'.'NEG_PERMIT_'.ANNUAL.IMP 1
/;

PARAMETER

UC_RHSRTS ' '/
'FI'.'NEG_PERMIT'.0.ANNUAL.UP 1
'FI'.'NEG_PERMIT'.2010.ANNUAL.UP 0
'FI'.'NEG_PERMIT'.2070.ANNUAL.UP 0
/;


